# Copy to .env.local and adjust. Never commit .env.local.

# Public base URL of the ASMS API (browser uses it for the SignalR hub).
NEXT_PUBLIC_API_URL=http://localhost:5001

# Server-side base URL of the API (used by the BFF proxy and server components).
# Defaults to NEXT_PUBLIC_API_URL when omitted (useful inside Docker networks).
API_URL=http://localhost:5001

# Public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
