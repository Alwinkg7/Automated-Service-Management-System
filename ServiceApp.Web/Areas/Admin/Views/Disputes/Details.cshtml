@model ServiceApp.Core.Entities.Dispute
@{
    ViewData["Title"] = $"Dispute #{Model.DisputeId}";
}

<div class="page-header">
    <div>
        <h2>Dispute #@Model.DisputeId</h2>
        <span style="font-size:13px; color:var(--text-secondary)">
            Request #@Model.RequestId ·
            @Model.ServiceRequest?.Category
        </span>
    </div>
    <a asp-action="Index" class="btn-outline">← All disputes</a>
</div>

<div style="display:grid; grid-template-columns:1fr 320px;
            gap:20px; align-items:start">

    @* ── Left: dispute detail ─────────────────────────────────── *@
    <div style="display:flex; flex-direction:column; gap:16px">

        @* Dispute info *@
        <div class="form-card">
            <div style="display:flex; justify-content:space-between;
                        align-items:center; margin-bottom:14px">
                <h3 style="font-size:15px; font-weight:600">
                    Dispute details
                </h3>
                @{
                    var sc = Model.Status switch
                    {
                        "Resolved"    => "status-completed",
                        "UnderReview" => "status-inprogress",
                        _             => "status-pending"
                    };
                }
                <span class="status-badge @sc">@Model.Status</span>
            </div>

            <div style="display:flex; flex-direction:column; gap:12px">
                <div>
                    <p style="font-size:11px; font-weight:600;
                              color:var(--text-secondary);
                              text-transform:uppercase;
                              letter-spacing:.5px; margin-bottom:3px">
                        Raised by
                    </p>
                    <p style="font-size:14px; font-weight:500">
                        @Model.RaisedBy?.FullName
                    </p>
                    <p style="font-size:12px; color:var(--text-secondary)">
                        @Model.RaisedBy?.Email ·
                        @Model.RaisedBy?.Phone
                    </p>
                </div>

                <div>
                    <p style="font-size:11px; font-weight:600;
                              color:var(--text-secondary);
                              text-transform:uppercase;
                              letter-spacing:.5px; margin-bottom:3px">
                        Reason
                    </p>
                    <span class="category-badge">
                        @Model.Reason.Replace("_"," ")
                    </span>
                </div>

                <div>
                    <p style="font-size:11px; font-weight:600;
                              color:var(--text-secondary);
                              text-transform:uppercase;
                              letter-spacing:.5px; margin-bottom:3px">
                        Description
                    </p>
                    <p style="font-size:13px; line-height:1.7">
                        @Model.Description
                    </p>
                </div>

                <div style="display:grid;
                            grid-template-columns:1fr 1fr; gap:12px">
                    <div>
                        <p style="font-size:11px; font-weight:600;
                                  color:var(--text-secondary);
                                  text-transform:uppercase;
                                  letter-spacing:.5px; margin-bottom:3px">
                            Raised at
                        </p>
                        <p style="font-size:13px">
                            @(Model.RaisedAt.ToString("dd MMM yyyy, hh:mm tt"))
                        </p>
                    </div>
                    <div>
                        <p style="font-size:11px; font-weight:600;
                                  @(Model.IsSlaBreached
                                    ? "color:var(--danger)"
                                    : "color:var(--text-secondary)");
                                  text-transform:uppercase;
                                  letter-spacing:.5px; margin-bottom:3px">
                            SLA deadline
                            @if (Model.IsSlaBreached)
                            {
                                <span>⚠ BREACHED</span>
                            }
                        </p>
                        <p style="font-size:13px;
                                  @(Model.IsSlaBreached
                                    ? "color:var(--danger)"
                                    : "")">
                            @(Model.SlaDeadline.ToString("dd MMM yyyy, hh:mm tt"))
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @* Request + payment info *@
        @if (Model.ServiceRequest != null)
        {
            <div class="form-card">
                <h3 style="font-size:15px; font-weight:600;
                           margin-bottom:14px">
                    Related request
                </h3>
                <div style="display:grid;
                            grid-template-columns:1fr 1fr; gap:12px">
                    <div>
                        <p style="font-size:11px; font-weight:600;
                                  color:var(--text-secondary);
                                  text-transform:uppercase;
                                  letter-spacing:.5px; margin-bottom:3px">
                            Customer
                        </p>
                        <p style="font-size:13px; font-weight:500">
                            @Model.ServiceRequest.Customer?.FullName
                        </p>
                        <p style="font-size:12px;
                                  color:var(--text-secondary)">
                            @Model.ServiceRequest.Customer?.Phone
                        </p>
                    </div>
                    <div>
                        <p style="font-size:11px; font-weight:600;
                                  color:var(--text-secondary);
                                  text-transform:uppercase;
                                  letter-spacing:.5px; margin-bottom:3px">
                            Technician
                        </p>
                        <p style="font-size:13px; font-weight:500">
                            @(Model.ServiceRequest.AssignedTechnician
                                ?.User?.FullName ?? "—")
                        </p>
                    </div>
                    @if (Model.ServiceRequest.Bill?.Payment != null)
                    {
                        <div>
                            <p style="font-size:11px; font-weight:600;
                                      color:var(--text-secondary);
                                      text-transform:uppercase;
                                      letter-spacing:.5px; margin-bottom:3px">
                                Amount paid
                            </p>
                            <p style="font-size:15px; font-weight:600; color:var(--success)">
                                ₹@(Model.ServiceRequest.Bill.Payment.Amount.ToString("N2"))
                            </p>
                       
                            <p style="font-size:13px">
                                @Model.ServiceRequest.Bill.Payment.PaymentMethod
                            </p>
        
                            <p style="font-size:11px; font-family:monospace; color:var(--text-muted)">
                                @Model.ServiceRequest.Bill.Payment.GatewayTransactionId
                            </p>
                        </div>
                    }
                </div>
            </div>
        }

        @* Refund info if issued *@
        @if (Model.RefundIssued)
        {
            <div style="background:#D1FAE5; border:1px solid #6EE7B7;
                        border-radius:var(--radius-lg); padding:16px">
                <p style="font-size:14px; font-weight:600;
                          color:#065F46; margin-bottom:8px">
                    ✓ Refund issued
                </p>
                <div style="display:flex; gap:20px; flex-wrap:wrap">
                    <div>
                        <p style="font-size:11px; color:#047857">
                            Amount
                        </p>
                        <p style="font-size:16px; font-weight:700;
                                  color:#065F46">
                            ₹@(Model.RefundAmount?.ToString("N2"))
                        </p>
                    </div>
                    <div>
                        <p style="font-size:11px; color:#047857">
                            Razorpay Refund ID
                        </p>
                        <p style="font-size:13px; font-family:monospace;
                                  color:#065F46">
                            @Model.RazorpayRefundId
                        </p>
                    </div>
                    <div>
                        <p style="font-size:11px; color:#047857">
                            Processed
                        </p>
                        <p style="font-size:13px; color:#065F46">
                            @(Model.ResolvedAt?.ToString("dd MMM yyyy"))
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>

    @* ── Right: admin action panel ────────────────────────────── *@
    <div style="display:flex; flex-direction:column; gap:12px">

        @* Start review *@
        @if (Model.Status == "Open")
        {
            <div class="form-card" style="padding:16px">
                <h4 style="font-size:13px; font-weight:600;
                           margin-bottom:10px">
                    Start review
                </h4>
                <form asp-action="StartReview"
                      asp-route-id="@Model.DisputeId"
                      method="post">
                    @Html.AntiForgeryToken()
                    <textarea name="adminNote"
                              class="form-control"
                              rows="2"
                              placeholder="Initial admin note..."
                              style="margin-bottom:8px"></textarea>
                    <button type="submit"
                            class="btn-primary"
                            style="width:100%">
                        Mark as under review
                    </button>
                </form>
            </div>
        }

        @* Issue refund *@
        @if ((Model.Status == "Open" || Model.Status == "UnderReview")
         && !Model.RefundIssued
         && Model.ServiceRequest?.Bill?.Payment != null)
        {
            var payment    = Model.ServiceRequest.Bill.Payment;
            var isCash     = string.IsNullOrEmpty(payment.GatewayTransactionId)
                          || payment.GatewayTransactionId.StartsWith("CASH");
            var maxRefund  = payment.Amount;

            <div class="form-card" style="padding:16px; border-color:#7C3AED">
                <h4 style="font-size:13px; font-weight:600;
                           margin-bottom:4px; color:#7C3AED">
                    Issue refund
                </h4>

                @if (isCash)
                {
                    @* Cash payment — no gateway refund possible *@
                    <div style="background:#FEF3C7; border:1px solid #FDE68A;
                                border-radius:8px; padding:12px; margin-bottom:12px">
                        <p style="font-size:12px; color:#92400E; font-weight:500;
                                   margin-bottom:4px">
                            💵 Cash payment — no gateway refund
                        </p>
                        <p style="font-size:12px; color:#78350F; line-height:1.6">
                            This request was paid in cash (₹@(maxRefund.ToString("N2"))).
                            You cannot issue an automatic refund.
                            Contact the customer directly to arrange a manual refund,
                            then close the dispute below with a note.
                        </p>
                    </div>

                    <div style="background:var(--bg-page); border-radius:6px;
                                padding:10px 12px; font-size:12px;
                                color:var(--text-secondary)">
                        Customer: <strong>@Model.ServiceRequest.Customer?.FullName</strong>
                        · @Model.ServiceRequest.Customer?.Phone
                    </div>
                }
                else
                {
                    @* Razorpay payment — can issue automatic refund *@
                    <p style="font-size:11px; color:var(--text-secondary);
                              margin-bottom:10px">
                        Max refundable: ₹@(maxRefund.ToString("N2"))
                        · Payment ID: <code style="font-size:10px">
                            @payment.GatewayTransactionId
                        </code>
                    </p>
                    <form asp-action="IssueRefund"
                          asp-route-id="@Model.DisputeId"
                          method="post"
                          onsubmit="return confirm('Issue Razorpay refund? This cannot be undone.')">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label style="font-size:12px">
                                Refund amount (₹)
                            </label>
                            <input id="refAmt"
                                   name="refundAmount"
                                   type="number"
                                   step="0.01"
                                   min="1"
                                   max="@maxRefund"
                                   value="@maxRefund"
                                   class="form-control"
                                   style="max-width:180px; margin-bottom:8px" />
                        </div>
                        <textarea name="adminNote"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Reason for refund..."
                                  required
                                  style="margin-bottom:8px"></textarea>
                        <button type="submit"
                                class="btn-primary"
                                style="width:100%;
                                       background:#7C3AED;
                                       border-color:#7C3AED">
                            Issue refund via Razorpay
                        </button>
                    </form>
                }
            </div>
        }
        @if (Model.Status != "Resolved")
        {
            <div class="form-card" style="padding:16px">
                <h4 style="font-size:13px; font-weight:600;
                           margin-bottom:10px">
                    Resolve dispute
                </h4>
                <form asp-action="Resolve"
                      asp-route-id="@Model.DisputeId"
                      method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label style="font-size:12px">Resolution</label>
                        <select name="resolution"
                                class="form-control"
                                style="margin-bottom:8px;
                                       font-size:13px">
                            <option value="Rejected">
                                Reject dispute — no action
                            </option>
                            <option value="ClosedNoAction">
                                Close — issue resolved without refund
                            </option>
                        </select>
                    </div>
                    <textarea name="adminNote"
                              class="form-control"
                              rows="2"
                              placeholder="Explain your decision..."
                              required
                              style="margin-bottom:8px"></textarea>
                    <button type="submit"
                            class="btn-outline"
                            style="width:100%">
                        Close dispute
                    </button>
                </form>
            </div>
        }

        @* Dispute is resolved *@
        @if (Model.Status == "Resolved")
        {
            <div class="form-card"
                 style="padding:16px; text-align:center">
                <p style="font-size:22px; margin-bottom:6px">✓</p>
                <p style="font-size:13px; font-weight:600;
                          color:var(--success)">
                    Dispute resolved
                </p>
                <p style="font-size:12px;
                          color:var(--text-secondary);
                          margin-top:4px">
                    @Model.Resolution ·
                    @(Model.ResolvedAt?.ToString("dd MMM yyyy"))
                </p>
            </div>
        }
    </div>
</div>