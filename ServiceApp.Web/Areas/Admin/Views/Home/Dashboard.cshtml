@* =================================================================
   Admin Dashboard
   
   Shows:
   1. Six stat cards (platform health at a glance)
   2. Pending requests table (oldest first — need assignment)
   
   Model = AdminDashboardViewModel
   ================================================================= *@

@model ServiceApp.Web.Areas.Admin.Models.AdminDashboardViewModel
@using ServiceApp.Core.Enums
@{
    ViewData["Title"] = "Admin dashboard";
}

<div class="page-header">
    <h2>Dashboard</h2>
    <div style="display:flex; gap:10px; align-items:center">
        <span style="font-size:13px; color:var(--text-secondary)">
            @DateTime.Now.ToString("dddd, dd MMMM yyyy")
        </span>

        @* Manual trigger — useful for testing or immediate assignment *@
        <form asp-area="Admin"
              asp-controller="Home"
              asp-action="RunAutoAssign"
              method="post">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="btn-outline btn-sm"
                    onclick="return confirm(
                        'Run auto-assignment now? ' +
                        'All pending requests will be processed.')">
                ⚡ Run auto-assign now
            </button>
        </form>
    </div>
</div>

@* ── Stat cards ──────────────────────────────────────────────── *@
<div class="stat-grid">

    <div class="stat-card stat-pending">
        <span class="stat-label">Pending</span>
        <span class="stat-value" data-stat-count="pending">@Model.PendingCount</span>
        <span style="font-size:12px; color:var(--text-muted)">
            Awaiting assignment
        </span>
    </div>

    <div class="stat-card stat-progress">
        <span class="stat-label">In progress</span>
        <span class="stat-value" data-stat-count="inProgress">@Model.InProgressCount</span>
        <span style="font-size:12px; color:var(--text-muted)">
            Active jobs
        </span>
    </div>
    <div style="margin-bottom:24px; text-align:right">
        <a asp-area="Admin"
           asp-controller="Analytics"
           asp-action="Index"
           class="btn-outline btn-sm">
            View full analytics →
        </a>
    </div>
    <div class="stat-card stat-done">
        <span class="stat-label">Completed</span>
        <span class="stat-value" data-stat-count="completed">@Model.CompletedCount</span>
        <span style="font-size:12px; color:var(--text-muted)">
            All time
        </span>
    </div>

    <div class="stat-card stat-tech">
        <span class="stat-label">Available techs</span>
        <span class="stat-value" data-stat-count="available">@Model.AvailableTechs</span>
        <span style="font-size:12px; color:var(--text-muted)">
            of @Model.TotalTechs total
        </span>
    </div>

    <div class="stat-card">
        <span class="stat-label">Customers</span>
        <span class="stat-value" style="color:var(--primary)">
            @Model.TotalCustomers
        </span>
        <span style="font-size:12px; color:var(--text-muted)">
            Registered
        </span>
    </div>

    <div class="stat-card">
        <span class="stat-label">Technicians</span>
        <span class="stat-value" style="color:#7C3AED">
            @Model.TotalTechs
        </span>
        <span style="font-size:12px; color:var(--text-muted)">
            Registered
        </span>
    </div>

</div>

@* ── Pending requests table ───────────────────────────────────── *@
<div class="table-card">

    <div class="table-card-header">
        <h3>Pending requests — need assignment</h3>
        @*
            Link to full requests list — built in Phase 2.
            href="#" for now so it doesn't break the build.
        *@
        <a asp-area="Admin" asp-controller="Requests"
           asp-action="Index" class="btn-link">View all →</a>
    </div>

    @if (!Model.PendingRequests.Any())
    {
        <div class="empty-state" style="border:none">
            <span class="empty-icon">✓</span>
            <h3>All caught up!</h3>
            <p>No pending requests right now.</p>
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Customer</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Requested</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.PendingRequests)
                {
                    <tr>
                        <td style="color:var(--text-muted)">#@r.RequestId</td>
                        <td>
                            <strong>@r.Customer.FullName</strong>
                            <br />
                            <span style="font-size:12px; color:var(--text-muted)">
                                @r.Customer.Phone
                            </span>
                        </td>
                        <td>
                            <span class="category-badge">@r.Category</span>
                        </td>
                        <td class="cell-truncate" title="@r.Description">
                            @r.Description
                        </td>
                        <td style="color:var(--text-secondary)">
                            @r.CreatedAt.ToString("dd MMM, hh:mm tt")
                        </td>
                        <td>
                            @*
                                Assign button — links to
                                /Admin/Requests/Assign/{id}
                                Built in Phase 2.
                            *@
                            <a asp-area="Admin" asp-controller="Requests"
                               asp-action="Assign"
                               asp-route-id="@r.RequestId"
                               class="btn-primary btn-sm">Assign</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>