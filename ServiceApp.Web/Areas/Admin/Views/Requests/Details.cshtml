@model ServiceApp.Core.Entities.ServiceRequest
@using ServiceApp.Core.Enums
@{
    ViewData["Title"] = $"Request #{Model.RequestId}";
}

<div class="page-header">
    <div>
        <h2>Request #@Model.RequestId</h2>
        <span style="font-size:13px; color:var(--text-secondary)">
            @Model.Category · @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
        </span>
    </div>
    <div style="display:flex; gap:8px">
        @if (Model.Status == RequestStatus.Pending)
        {
            <a asp-action="Assign"
               asp-route-id="@Model.RequestId"
               class="btn-primary">
                Assign technician
            </a>
        }
        <a asp-action="Index" class="btn-outline">
            ← All requests
        </a>
    </div>
</div>

<div style="display:grid; grid-template-columns:1fr 300px;
            gap:20px; align-items:start">

    @* ── Left: detail + timeline ─────────────────────────────── *@
    <div style="display:flex; flex-direction:column; gap:16px">

        @* Request info *@
        <div class="form-card">
            <div style="display:flex; justify-content:space-between;
                        margin-bottom:16px">
                <h3 style="font-size:15px; font-weight:600">
                    Request details
                </h3>
                <span class="status-badge
                    status-@Model.Status.ToString().ToLower()">
                    @Model.Status
                </span>
            </div>

            <div style="display:grid; gap:14px">
                <div style="display:grid;
                            grid-template-columns:1fr 1fr; gap:14px">
                    <div>
                        <p style="font-size:11px; font-weight:600;
                                  color:var(--text-secondary);
                                  text-transform:uppercase;
                                  letter-spacing:.5px; margin-bottom:3px">
                            Customer
                        </p>
                        <p style="font-weight:500">
                            @Model.Customer.FullName
                        </p>
                        <p style="font-size:12px;
                                  color:var(--text-secondary)">
                            @Model.Customer.Phone
                        </p>
                        <p style="font-size:12px;
                                  color:var(--text-secondary)">
                            @Model.Customer.Email
                        </p>
                    </div>
                    <div>
                        <p style="font-size:11px; font-weight:600;
                                  color:var(--text-secondary);
                                  text-transform:uppercase;
                                  letter-spacing:.5px; margin-bottom:3px">
                            Service
                        </p>
                        <span class="category-badge">
                            @Model.Category
                        </span>
                    </div>
                </div>

                <div>
                    <p style="font-size:11px; font-weight:600;
                              color:var(--text-secondary);
                              text-transform:uppercase;
                              letter-spacing:.5px; margin-bottom:3px">
                        Description
                    </p>
                    <p style="font-size:13px; line-height:1.6">
                        @Model.Description
                    </p>
                </div>

                <div style="display:grid;
                            grid-template-columns:1fr 1fr; gap:14px">
                    <div>
                        <p style="font-size:11px; font-weight:600;
                                  color:var(--text-secondary);
                                  text-transform:uppercase;
                                  letter-spacing:.5px; margin-bottom:3px">
                            Address
                        </p>
                        <p style="font-size:13px">@Model.Address</p>
                        <p style="font-size:12px;
                                  color:var(--text-muted)">
                            Pin: @Model.PinCode
                        </p>
                    </div>
                    <div>
                        <p style="font-size:11px; font-weight:600;
                                  color:var(--text-secondary);
                                  text-transform:uppercase;
                                  letter-spacing:.5px; margin-bottom:3px">
                            Preferred time
                        </p>
                        <p style="font-size:13px">
                            @Model.PreferredDateTime.ToString("dd MMM yyyy, hh:mm tt")
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @* Assigned technician *@
        @if (Model.AssignedTechnician != null)
        {
            <div class="form-card">
                <h3 style="font-size:15px; font-weight:600;
                               margin-bottom:14px">
                    Assigned technician
                </h3>
                <div style="display:flex; gap:14px; align-items:center">
                    <div style="width:48px; height:48px; border-radius:50%;
                                    background:#7C3AED22; color:#7C3AED;
                                    display:flex; align-items:center;
                                    justify-content:center; font-size:20px;
                                    font-weight:700; flex-shrink:0">
                        @(Model.AssignedTechnician.User.FullName.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <p style="font-weight:600; margin-bottom:2px">
                            @Model.AssignedTechnician.User.FullName
                        </p>
                        <p style="font-size:12px;
                                      color:var(--text-secondary)">
                            @Model.AssignedTechnician.Skill
                            @if (Model.AssignedTechnician.Rating > 0)
                            {
                                <span style="color:#D97706; margin-left:6px">
                                    ★ @Model.AssignedTechnician.Rating.ToString("F1")
                                </span>
                            }
                        </p>
                        <p style="font-size:12px;
                                      color:var(--text-secondary)">
                            📞 @Model.AssignedTechnician.User.Phone
                        </p>
                    </div>
                </div>
            </div>
        }

        @* Status timeline *@
        @if (Model.History != null && Model.History.Any())
        {
            <div class="form-card">
                <h3 style="font-size:15px; font-weight:600;
                               margin-bottom:16px">
                    Status timeline
                </h3>
                <div style="display:flex; flex-direction:column">
                    @foreach (var h in Model.History.OrderBy(x => x.ChangedAt))
                    {
                        <div style="display:flex; gap:12px;
                                            align-items:flex-start;
                                            padding-bottom:16px; position:relative">
                            @if (h != Model.History.OrderBy(x => x.ChangedAt).Last())
                            {
                                <div style="position:absolute; left:11px;top:22px; bottom:0; width:1px;background:var(--border)">
                                </div>
                            }
                            <div style="width:22px; height:22px;
                                                border-radius:50%; flex-shrink:0;
                                                display:flex; align-items:center;
                                                justify-content:center;
                                                font-size:9px; font-weight:700;
                                                z-index:1;
                                                background:var(--primary-light);
                                                color:var(--primary)">
                                ✓
                            </div>
                            <div>
                                <p style="font-size:13px; font-weight:500;
                                                  margin-bottom:1px">
                                    @h.Status
                                </p>
                                <p style="font-size:12px;
                                                  color:var(--text-secondary)">
                                    @h.Note
                                </p>
                                <p style="font-size:11px;
                                                  color:var(--text-muted)">
                                    @h.ChangedAt.ToString("dd MMM yyyy, hh:mm tt")
                        </p>
                    </div>
                </div>
                }
                </div>
            </div>
        }
    </div>

    @* ── Right: admin actions ─────────────────────────────────── *@
    <div style="display:flex; flex-direction:column; gap:12px">
        <div class="form-card" style="padding:16px">
            <h4 style="font-size:13px; font-weight:600;
                       margin-bottom:12px">
                Admin actions
            </h4>

            @if (Model.Status == RequestStatus.Pending)
            {
                <a asp-action="Assign"
                   asp-route-id="@Model.RequestId"
                   class="btn-primary"
                   style="display:block; text-align:center;
                              margin-bottom:8px">
                    Assign technician
                </a>
            }

            @if (Model.Status == RequestStatus.Pending ||
                        Model.Status == RequestStatus.Assigned)
            {
                <form asp-action="Cancel"
                      asp-route-id="@Model.RequestId"
                      method="post"
                      onsubmit="return confirm(
                              'Cancel request #@Model.RequestId?')">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn-danger"
                            style="width:100%">
                        Cancel request
                    </button>
                </form>
            }

            @if (Model.Status == RequestStatus.Completed ||
                        Model.Status == RequestStatus.Cancelled ||
                        Model.Status == RequestStatus.InProgress ||
                        Model.Status == RequestStatus.Billed)
            {
                <p style="font-size:12px; color:var(--text-muted);
                              text-align:center">
                    No admin actions available for
                    @Model.Status requests.
                </p>
            }
        </div>

        @* Quick info box *@
        <div class="form-card" style="padding:16px">
            <h4 style="font-size:13px; font-weight:600;
                       margin-bottom:10px">
                Quick info
            </h4>
            <div style="display:flex; flex-direction:column; gap:8px">
                <div style="display:flex; justify-content:space-between">
                    <span style="font-size:12px;
                                 color:var(--text-secondary)">
                        Request ID
                    </span>
                    <span style="font-size:12px; font-weight:500">
                        #@Model.RequestId
                    </span>
                </div>
                <div style="display:flex; justify-content:space-between">
                    <span style="font-size:12px;
                                 color:var(--text-secondary)">
                        Created
                    </span>
                    <span style="font-size:12px">
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </span>
                </div>
                <div style="display:flex; justify-content:space-between">
                    <span style="font-size:12px;
                                 color:var(--text-secondary)">
                        Category
                    </span>
                    <span class="category-badge"
                          style="font-size:11px">
                        @Model.Category
                    </span>
                </div>
                <div style="display:flex; justify-content:space-between">
                    <span style="font-size:12px;
                                 color:var(--text-secondary)">
                        Status
                    </span>
                    <span class="status-badge
                        status-@Model.Status.ToString().ToLower()"
                          style="font-size:11px">
                        @Model.Status
                    </span>
                </div>
                @if (Model.CustomerRating.HasValue)
                {
                    <div style="display:flex; justify-content:space-between">
                        <span style="font-size:12px;
                                         color:var(--text-secondary)">
                            Rating
                        </span>
                        <span style="font-size:12px; color:#D97706">
                            @string.Concat(Enumerable.Repeat("★",Model.CustomerRating.Value))
                    </span>
                </div>
                                }
            </div>
        </div>
    </div>
</div>