@model ServiceApp.Web.Areas.Admin.Models.UserListViewModel
@using ServiceApp.Core.Enums
@{
    ViewData["Title"] = "All users";
}

<div class="page-header">
    <h2>All users</h2>
    <a asp-action="Create" class="btn-primary">
        + Create admin
    </a>
</div>

@* ── Filter tabs ──────────────────────────────────────────────── *@
<div style="display:flex; gap:6px; margin-bottom:20px; flex-wrap:wrap">
    @{
        var tabs = new[]
        {
        (label:"All",         value:(string?)null,  count:Model.TotalCount),
        (label:"Admins",      value:"Admin",        count:Model.AdminCount),
        (label:"Technicians", value:"Technician",   count:Model.TechnicianCount),
        (label:"Customers",   value:"Customer",     count:Model.CustomerCount),
        };
    }
    @foreach (var tab in tabs)
    {
        var isActive = (tab.value == null && Model.CurrentFilter == null)
        || tab.value == Model.CurrentFilter?.ToString();
        <a asp-action="Index"
           asp-route-filter="@tab.value"
           style="padding:6px 14px; border-radius:20px; font-size:12.5px;
                      font-weight:500; text-decoration:none; border:1px solid;
                      @(isActive
                               ? "background:var(--primary);color:#fff;border-color:var(--primary)"
                               : "background:var(--bg-white);color:var(--text-secondary);border-color:var(--border)")">
            @tab.label
            <span style="opacity:.8">(@tab.count)</span>
        </a>
    }
</div>

@if (!Model.AllUsers.Any())
{
    <div class="empty-state">
        <span class="empty-icon">👥</span>
        <h3>No users found</h3>
        <p>
            @(Model.CurrentFilter != null
                    ? $"No {Model.CurrentFilter} accounts yet."
                    : "No users registered yet.")
        </p>
    </div>
}
else
{
    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Phone</th>
                    <th>Joined</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.AllUsers)
                {
                    <tr style="@(!u.IsActive ? "opacity:0.55" : "")">
                        <td>
                            <div style="display:flex; gap:10px;
                                                align-items:center">
                                @*Avatar*@
                                <div style="width:34px; height:34px;
                                                    border-radius:50%;
                                                    display:flex;
                                                    align-items:center;
                                                    justify-content:center;
                                                    font-size:14px;
                                                    font-weight:700;
                                                    flex-shrink:0;
                                                    @(u.Role == UserRole.Admin
                                                                                     ? "background:#FEE2E2;color:#DC2626"
                                                                                     : u.Role == UserRole.Technician
                                                                                         ? "background:#EDE9FE;color:#7C3AED"
                                                                                         : "background:#DBEAFE;color:#2563EB")">
                                    @(u.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <p style="font-size:13px;
                                                      font-weight:500;
                                                      margin-bottom:1px">
                                        @u.FullName
                                    </p>
                                    <p style="font-size:11px;
                                                      color:var(--text-muted)">
                                        @u.Email
                                    </p>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="role-badge
                                        @(u.Role == UserRole.Admin ? "role-admin"
                                                                  : u.Role == UserRole.Technician ? "role-tech"
                                                                  : "role-customer")"
                                  style="font-size:11px;
                                                 padding:3px 10px">
                                @u.Role
                            </span>
                        </td>
                        <td style="font-size:13px;
                                           color:var(--text-secondary)">
                            @u.Phone
                        </td>
                        <td style="font-size:12px;
                                           color:var(--text-secondary)">
                            @(u.CreatedAt.ToString("dd MMM yyyy"))
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span style="font-size:11px;
                                                         padding:2px 8px;
                                                         border-radius:20px;
                                                         background:var(--success-light);
                                                         color:var(--success);
                                                         font-weight:600">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span style="font-size:11px;
                                                         padding:2px 8px;
                                                         border-radius:20px;
                                                         background:var(--danger-light);
                                                         color:var(--danger);
                                                         font-weight:600">
                                    Inactive
                                </span>
                            }
                        </td>
                        <td>
                            <div style="display:flex; gap:6px">
                                @if (u.IsActive)
                                {
                                    @* Cannot deactivate system admin *@
                                    @if (u.Email != "admin@serviceapp.com")
                                    {
                                        <form asp-action="Deactivate"
                                              asp-route-id="@u.Id"
                                              method="post"
                                              onsubmit="return confirm(
                                                                  'Deactivate @u.FullName? ' +
                                                                  'They will not be able to login.')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn-danger btn-sm">
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span style="font-size:11px;
                                                                     color:var(--text-muted)">
                                            System admin
                                        </span>
                                    }
                                }
                                else
                                {
                                    <form asp-action="Reactivate"
                                          asp-route-id="@u.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn-outline btn-sm">
                                            Reactivate
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}