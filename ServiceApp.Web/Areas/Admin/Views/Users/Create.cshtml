@model ServiceApp.Web.Areas.Admin.Models.CreateAdminViewModel
@{
    ViewData["Title"] = "Create admin account";
}

<div class="page-header">
    <div>
        <h2>Create admin account</h2>
        <span style="font-size:13px; color:var(--text-secondary)">
            New admin will be able to log in immediately
        </span>
    </div>
    <a asp-action="Index" class="btn-outline">← All users</a>
</div>

<div style="display:grid; grid-template-columns:1fr 320px;
            gap:24px; align-items:start; max-width:900px">

    @* ── Left: form ──────────────────────────────────────────── *@
    <div class="form-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="toast toast-error"
                 style="margin-bottom:16px"></div>

            <h3 style="font-size:15px; font-weight:600;
                       margin-bottom:16px; padding-bottom:12px;
                       border-bottom:1px solid var(--border)">
                Account details
            </h3>

            <div class="form-group">
                <label asp-for="FullName">Full name</label>
                <input asp-for="FullName"
                       class="form-control"
                       placeholder="Jane Smith"
                       autofocus />
                <span asp-validation-for="FullName"
                      class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="jane@serviceapp.com" />
                <span asp-validation-for="Email"
                      class="field-error"></span>
                <span class="form-hint">
                    This will be their login email
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Phone">Phone number</label>
                <input asp-for="Phone"
                       class="form-control"
                       placeholder="98765 43210" />
                <span asp-validation-for="Phone"
                      class="field-error"></span>
            </div>

            <div style="display:grid;
                        grid-template-columns:1fr 1fr; gap:16px">
                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password"
                           class="form-control"
                           placeholder="Min. 8 characters"
                           type="password" />
                    <span asp-validation-for="Password"
                          class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword">
                        Confirm password
                    </label>
                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           placeholder="Repeat password"
                           type="password" />
                    <span asp-validation-for="ConfirmPassword"
                          class="field-error"></span>
                </div>
            </div>

            <h3 style="font-size:15px; font-weight:600;
                       margin-top:20px; margin-bottom:16px;
                       padding-bottom:12px;
                       border-bottom:1px solid var(--border)">
                Profile details
                <span style="font-size:12px; font-weight:400;
                             color:var(--text-muted)">
                    (optional — can be updated later)
                </span>
            </h3>

            <div style="display:grid;
                        grid-template-columns:1fr 1fr; gap:16px">
                <div class="form-group">
                    <label asp-for="Department">Department</label>
                    <input asp-for="Department"
                           class="form-control"
                           placeholder="e.g. Operations" />
                </div>
                <div class="form-group">
                    <label asp-for="Designation">Designation</label>
                    <input asp-for="Designation"
                           class="form-control"
                           placeholder="e.g. Manager" />
                </div>
            </div>

            <div style="display:flex; gap:10px; margin-top:8px">
                <button type="submit" class="btn-primary">
                    Create admin account
                </button>
                <a asp-action="Index" class="btn-outline">Cancel</a>
            </div>
        </form>
    </div>

    @* ── Right: info card ─────────────────────────────────────── *@
    <div style="display:flex; flex-direction:column; gap:12px">

        <div class="form-card" style="padding:16px">
            <h4 style="font-size:13px; font-weight:600;
                       margin-bottom:10px">
                What admins can do
            </h4>
            <ul style="padding-left:16px;
                       display:flex; flex-direction:column; gap:6px">
                <li style="font-size:12px;
                           color:var(--text-secondary)">
                    View and manage all service requests
                </li>
                <li style="font-size:12px;
                           color:var(--text-secondary)">
                    Assign technicians to requests
                </li>
                <li style="font-size:12px;
                           color:var(--text-secondary)">
                    View all customers and technicians
                </li>
                <li style="font-size:12px;
                           color:var(--text-secondary)">
                    Create new admin accounts
                </li>
                <li style="font-size:12px;
                           color:var(--text-secondary)">
                    Deactivate user accounts
                </li>
            </ul>
        </div>

        <div class="form-card"
             style="padding:16px; background:#FEF3C7;
                    border-color:#FDE68A">
            <h4 style="font-size:13px; font-weight:600;
                       margin-bottom:8px; color:#92400E">
                ⚠ Security reminder
            </h4>
            <p style="font-size:12px; color:#78350F;
                      line-height:1.6">
                Share the password securely.
                Ask the new admin to change it after
                their first login. Admin accounts have
                full access to the platform.
            </p>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}