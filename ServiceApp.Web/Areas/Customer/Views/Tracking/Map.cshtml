@model ServiceApp.Core.Entities.ServiceRequest
@{
    ViewData["Title"] = $"Tracking — Job #{Model.RequestId}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h2>Live tracking</h2>
        <span style="font-size:13px; color:var(--text-secondary)">
            Job #@Model.RequestId · @Model.Category
        </span>
    </div>
    <a asp-area="Customer"
       asp-controller="Requests"
       asp-action="Details"
       asp-route-id="@Model.RequestId"
       class="btn-outline">
        ← Back to request
    </a>
</div>

@* ── Status bar ───────────────────────────────────────────────── *@
<div style="background:var(--success-light);
    border:1px solid #6EE7B7;
    border-radius:var(--radius);
    padding:12px 16px; margin-bottom:16px;
    display:flex; align-items:center; gap:12px">

    @* Animated pulse dot *@
    <div style="position:relative; width:14px; height:14px;
        flex-shrink:0">
        <div style="position:absolute; width:14px; height:14px;
        border-radius:50%; background:var(--success);
        animation:ping 1.5s cubic-bezier(0,0,0.2,1) infinite;
        opacity:.75"></div>
        <div style="position:relative; width:10px; height:10px;
        border-radius:50%; background:var(--success);
        margin:2px"></div>
    </div>

    <div>
        <p style="font-size:14px; font-weight:600;
            color:#065F46; margin-bottom:2px">
            @Model.AssignedTechnician?.User?.FullName is on the way
        </p>
        <p style="font-size:12px; color:#047857">
            Map updates every 30 seconds ·
            📞 @Model.AssignedTechnician?.User?.Phone
        </p>
    </div>

    @* ETA placeholder *@
    <div style="margin-left:auto; text-align:right">
        <p style="font-size:11px; color:#047857">Your address</p>
        <p style="font-size:13px; font-weight:500; color:#065F46">
            @Model.Address
        </p>
    </div>
</div>

@* ── Map container ────────────────────────────────────────────── *@
<div style="position:relative; border-radius:var(--radius-lg);
    overflow:hidden; border:1px solid var(--border);
    margin-bottom:16px">

    <div id="map" style="height:480px; width:100%;
    background:#E5E7EB"></div>

    @* Loading overlay *@
    <div id="map-loading"
         style="position:absolute; inset:0;
        background:rgba(255,255,255,.85);
        display:flex; align-items:center;
        justify-content:center; flex-direction:column;
        gap:10px; z-index:1000">
        <div style="width:32px; height:32px; border:3px solid var(--border);
        border-top-color:var(--primary); border-radius:50%;
        animation:spin 1s linear infinite"></div>
        <p style="font-size:13px; color:var(--text-secondary)">
            Waiting for technician location...
        </p>
    </div>

    @* Last update badge *@
    <div id="last-update"
         style="display:none; position:absolute; bottom:12px;
        right:12px; z-index:999; background:rgba(0,0,0,.6);
        color:#fff; font-size:11px; padding:4px 10px;
        border-radius:20px; pointer-events:none">
        Updated: <span id="update-time">—</span>
    </div>
</div>

@* ── Info cards row ───────────────────────────────────────────── *@
<div style="display:grid; grid-template-columns:1fr 1fr 1fr;
    gap:12px; margin-bottom:16px">

    @* Technician info *@
    <div class="form-card" style="padding:14px">
        <p style="font-size:11px; font-weight:600;
            color:var(--text-secondary);
            text-transform:uppercase; letter-spacing:.5px;
            margin-bottom:8px">
            Your technician
        </p>
        <div style="display:flex; gap:10px; align-items:center">
            <div style="width:36px; height:36px; border-radius:50%;
                background:#7C3AED22; color:#7C3AED;
                display:flex; align-items:center;
                justify-content:center; font-size:14px;
                font-weight:700; flex-shrink:0">
                @(Model.AssignedTechnician?.User?.FullName
                    .Substring(0, 1).ToUpper() ?? "T")
            </div>
            <div>
                <p style="font-size:13px; font-weight:500;
                    margin-bottom:1px">
                    @Model.AssignedTechnician?.User?.FullName
                </p>
                <p style="font-size:11px; color:var(--text-secondary)">
                    @Model.AssignedTechnician?.Skill
                    @if (Model.AssignedTechnician?.Rating > 0)
                    {
                        <span style="color:#D97706; margin-left:4px">
                            ★ @(Model.AssignedTechnician.Rating.ToString("F1"))
                        </span>
                    }
                </p>
            </div>
        </div>
    </div>

    @* Service info *@
    <div class="form-card" style="padding:14px">
        <p style="font-size:11px; font-weight:600;
            color:var(--text-secondary);
            text-transform:uppercase; letter-spacing:.5px;
            margin-bottom:8px">
            Service
        </p>
        <span class="category-badge"
              style="font-size:13px; padding:4px 12px">
            @Model.Category
        </span>
        <p style="font-size:12px; color:var(--text-secondary);
            margin-top:6px; line-height:1.5">
            @Model.Description
        </p>
    </div>

    @* Location status *@
    <div class="form-card" style="padding:14px">
        <p style="font-size:11px; font-weight:600;
            color:var(--text-secondary);
            text-transform:uppercase; letter-spacing:.5px;
            margin-bottom:8px">
            Location status
        </p>
        <div id="location-status">
            <p style="font-size:13px; color:var(--text-secondary)">
                Waiting for location...
            </p>
        </div>
    </div>
</div>

@* ── Destination address *@
<div class="form-card" style="padding:14px">
    <p style="font-size:11px; font-weight:600;
        color:var(--text-secondary);
        text-transform:uppercase; letter-spacing:.5px;
        margin-bottom:6px">
        Service address (destination)
    </p>
    <p style="font-size:14px; font-weight:500">
        📍 @Model.Address, @Model.PinCode
    </p>
</div>

@* CSS animations *@
<style>
    @@keyframes ping {
        75%, 100% { transform: scale(2); opacity: 0; }
    }
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@section Scripts {
    @* Leaflet.js — open source map library, no API key needed *@
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        var REQUEST_ID  = @Model.RequestId;
        var CUSTOMER_ID = '@Model.CustomerId';
        var TECH_NAME   = '@Html.Raw(Model.AssignedTechnician?.User?.FullName ?? "Technician")';
        var DESTINATION = '@Html.Raw(Model.Address)';

        // ── Initialize Leaflet map ────────────────────────────────────
        var map = L.map('map').setView([10.5276, 76.2144], 13);
        // 10.5276, 76.2144 = Thrissur, Kerala as default center

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors',
            maxZoom: 19
        }).addTo(map);

        // Custom icons
        var techIcon = L.divIcon({
            html: '<div style="background:#4F46E5;width:36px;height:36px;' +
                  'border-radius:50%;border:3px solid #fff;' +
                  'box-shadow:0 2px 8px rgba(0,0,0,.3);' +
                  'display:flex;align-items:center;justify-content:center;' +
                  'font-size:16px;color:#fff;cursor:pointer">' +
                  '🔧</div>',
            className: '',
            iconSize:  [36, 36],
            iconAnchor:[18, 18]
        });

        var destIcon = L.divIcon({
            html: '<div style="background:#EF4444;width:32px;height:32px;' +
                  'border-radius:50% 50% 50% 0;transform:rotate(-45deg);' +
                  'border:2px solid #fff;' +
                  'box-shadow:0 2px 8px rgba(0,0,0,.3)"></div>',
            className: '',
            iconSize:  [32, 32],
            iconAnchor:[16, 32]
        });

        var techMarker   = null;
        var destMarker   = null;
        var routeLine    = null;
        var firstUpdate  = true;

        // ── SignalR connection ────────────────────────────────────────
        var connection = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/service')
            .withAutomaticReconnect()
            .configureLogging(signalR.LogLevel.Warning)
            .build();

        // Handle live location updates
        connection.on('LocationUpdate', function(data) {
            if (data.requestId !== REQUEST_ID) return;

            var lat = data.lat;
            var lng = data.lng;
            var now = new Date(data.timestamp);

            // Hide loading overlay
            document.getElementById('map-loading').style.display = 'none';
            document.getElementById('last-update').style.display = 'block';
            document.getElementById('update-time').textContent   =
                now.toLocaleTimeString();

            // Update or create technician marker
            if (techMarker) {
                techMarker.setLatLng([lat, lng]);
            } else {
                techMarker = L.marker([lat, lng], { icon: techIcon })
                    .addTo(map)
                    .bindPopup(
                        '<strong>' + TECH_NAME + '</strong><br/>' +
                        'Your technician · Updated ' +
                        now.toLocaleTimeString());
            }

            // Add destination marker on first update
            if (firstUpdate) {
                firstUpdate = false;

                // Try to geocode the destination address (OpenStreetMap Nominatim)
                geocodeAddress('@Html.Raw(Model.Address + ", " + Model.PinCode)')
                    .then(function(coords) {
                        if (coords) {
                            destMarker = L.marker(coords, { icon: destIcon })
                                .addTo(map)
                                .bindPopup(
                                    '<strong>Service address</strong><br/>' +
                                    DESTINATION);
                            drawRoute([lat, lng], coords);
                        }
                    });

                // Zoom to show technician
                map.setView([lat, lng], 15);
            }

            // Update route line
            if (destMarker) {
                drawRoute([lat, lng], destMarker.getLatLng());
            }

            // Update location status card
            document.getElementById('location-status').innerHTML =
                '<p style="font-size:12px;color:var(--success);' +
                'font-weight:500">✓ Live location active</p>' +
                '<p style="font-size:11px;color:var(--text-muted);' +
                'margin-top:2px">Last update: ' +
                now.toLocaleTimeString() + '</p>';
        });

        // Handle location stopped (job complete)
        connection.on('LocationStopped', function(data) {
            if (data.requestId !== REQUEST_ID) return;

            document.getElementById('location-status').innerHTML =
                '<p style="font-size:12px;color:var(--text-secondary)">' +
                'Technician has arrived. Location sharing stopped.</p>';
        });

        // Start connection and join group
        connection.start()
            .then(function() {
                return connection.invoke(
                    'JoinGroup', 'Customer', CUSTOMER_ID);
            })
            .catch(function(err) {
                console.error('SignalR error:', err);
            });

        // ── Draw a simple straight line between two points ────────────
        // For real routing use OSRM or GraphHopper API
        function drawRoute(from, to) {
            if (routeLine) map.removeLayer(routeLine);
            routeLine = L.polyline([from, to], {
                color:  '#4F46E5',
                weight: 4,
                opacity: 0.7,
                dashArray: '8, 6'
            }).addTo(map);

            // Fit map to show both points
            map.fitBounds(routeLine.getBounds(), { padding: [40, 40] });
        }

        // ── Geocode an address using OpenStreetMap Nominatim ─────────
        async function geocodeAddress(address) {
            try {
                var url = 'https://nominatim.openstreetmap.org/search?' +
                    'format=json&q=' + encodeURIComponent(address) +
                    '&limit=1';
                var res  = await fetch(url, {
                    headers: { 'Accept-Language': 'en' }
                });
                var data = await res.json();
                if (data.length > 0)
                    return [parseFloat(data[0].lat), parseFloat(data[0].lon)];
            } catch (e) {
                console.warn('Geocode failed:', e);
            }
            return null;
        }
    </script>
}