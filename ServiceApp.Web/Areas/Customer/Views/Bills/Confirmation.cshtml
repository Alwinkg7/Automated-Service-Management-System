@model ServiceApp.Core.Entities.Payment
@{
    ViewData["Title"] = "Payment confirmed";
}

<div style="max-width:560px; margin:40px auto">
    <div class="form-card" style="text-align:center; padding:40px">

        @* Success icon *@
        <div style="width:72px; height:72px; border-radius:50%;
                    background:var(--success-light); color:var(--success);
                    display:flex; align-items:center;
                    justify-content:center; font-size:32px;
                    margin:0 auto 20px">
            ✓
        </div>

        <h2 style="font-size:24px; font-weight:700; margin-bottom:8px">
            Payment confirmed!
        </h2>
        <p style="font-size:15px; color:var(--text-secondary);
                  margin-bottom:28px">
            Thank you for using ServiceApp.
            Your request has been marked as completed.
        </p>

        @* Payment receipt *@
        <div style="background:var(--bg-page); border-radius:var(--radius);
                    padding:18px; margin-bottom:24px; text-align:left">
            <p style="font-size:12px; font-weight:600;
                      color:var(--text-secondary);
                      text-transform:uppercase; letter-spacing:.5px;
                      margin-bottom:12px">
                Payment receipt
            </p>
            <div style="display:flex; flex-direction:column; gap:8px">
                <div style="display:flex; justify-content:space-between">
                    <span style="font-size:13px;
                                 color:var(--text-secondary)">
                        Payment ID
                    </span>
                    <span style="font-size:13px; font-weight:500">
                        #@Model.PaymentId
                    </span>
                </div>
                <div style="display:flex; justify-content:space-between">
                    <span style="font-size:13px;
                                 color:var(--text-secondary)">
                        Bill ID
                    </span>
                    <span style="font-size:13px; font-weight:500">
                        #@Model.BillId
                    </span>
                </div>
                <div style="display:flex; justify-content:space-between">
                    <span style="font-size:13px;
                                 color:var(--text-secondary)">
                        Amount paid
                    </span>
                    <span style="font-size:15px; font-weight:700;
                                 color:var(--success)">
                        ₹@(Model.Amount.ToString("N2"))
                    </span>
                </div>
                <div style="display:flex; justify-content:space-between">
                    <span style="font-size:13px;
                                 color:var(--text-secondary)">
                        Method
                    </span>
                    <span style="font-size:13px; font-weight:500">
                        @Model.PaymentMethod
                    </span>
                </div>
                <div style="display:flex; justify-content:space-between">
                    <span style="font-size:13px;
                                 color:var(--text-secondary)">
                        Paid at
                    </span>
                    <span style="font-size:13px">
                        @(Model.PaidAt.ToString("dd MMM yyyy, hh:mm tt"))
                    </span>
                </div>
                @if (!string.IsNullOrEmpty(Model.GatewayTransactionId))
                {
                    <div style="display:flex; justify-content:space-between">
                        <span style="font-size:13px;
                                         color:var(--text-secondary)">
                            Transaction ref
                        </span>
                        <span style="font-size:12px;
                                         font-family:var(--font-mono);
                                         color:var(--text-secondary)">
                            @Model.GatewayTransactionId
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div style="display:flex; gap:10px; justify-content:center;
                    flex-wrap:wrap">
            <a asp-area="Customer"
               asp-controller="Requests"
               asp-action="Index"
               class="btn-primary">
                View my requests
            </a>
            <a asp-area="Customer"
               asp-controller="Requests"
               asp-action="Create"
               class="btn-outline">
                Book another service
            </a>
        </div>

        <p style="font-size:12px; color:var(--text-muted);
                  margin-top:20px">
            Don't forget to leave a rating for your technician!
        </p>
    </div>
</div>