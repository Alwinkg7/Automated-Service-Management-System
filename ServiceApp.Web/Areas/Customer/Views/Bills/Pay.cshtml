@model ServiceApp.Core.Entities.Bill
@using ServiceApp.Core.Enums
@{
    ViewData["Title"] = "Pay bill";
}

<div class="page-header">
    <div>
        <h2>Pay bill</h2>
        <span style="font-size:13px; color:var(--text-secondary)">
            Bill #@Model.BillId · Request #@Model.RequestId
        </span>
    </div>
    <a asp-area="Customer"
       asp-controller="Requests"
       asp-action="Index"
       class="btn-outline">
        ← My requests
    </a>
</div>

<div style="display:grid; grid-template-columns:1fr 340px;
            gap:20px; align-items:start; max-width:900px">

    @* ── Left: bill details ───────────────────────────────────── *@
    <div>
        <div class="form-card">
            <h3 style="font-size:16px; font-weight:600;
                       margin-bottom:16px">
                Bill summary
            </h3>

            @* Technician info *@
            @if (Model.Technician != null)
            {
                <div style="display:flex; gap:12px; align-items:center;
                                padding:12px; background:var(--bg-page);
                                border-radius:var(--radius);
                                margin-bottom:16px">
                    <div style="width:40px; height:40px; border-radius:50%;
                                    background:#7C3AED22; color:#7C3AED;
                                    display:flex; align-items:center;
                                    justify-content:center; font-size:16px;
                                    font-weight:700; flex-shrink:0">
                        @(Model.Technician.User.FullName.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <p style="font-size:14px; font-weight:600;
                                      margin-bottom:1px">
                            @Model.Technician.User.FullName
                        </p>
                        <p style="font-size:12px;
                                      color:var(--text-secondary)">
                            @Model.Technician.Skill
                            @if (Model.Technician.Rating > 0)
                            {
                                <span style="color:#D97706;
                                                     margin-left:6px">
                                    ★ @(Model.Technician.Rating.ToString("F1"))
                                </span>
                            }
                        </p>
                    </div>
                </div>
            }

            @* Line items table *@
            <table style="width:100%; border-collapse:collapse;
                          margin-bottom:16px">
                <thead>
                    <tr style="border-bottom:1.5px solid var(--border)">
                        <th style="text-align:left; padding:8px 0;
                                   font-size:11px; font-weight:600;
                                   color:var(--text-secondary);
                                   text-transform:uppercase;
                                   letter-spacing:.5px">
                            Description
                        </th>
                        <th style="text-align:center; padding:8px 0;
                                   font-size:11px; font-weight:600;
                                   color:var(--text-secondary);
                                   text-transform:uppercase;
                                   letter-spacing:.5px; width:50px">
                            Qty
                        </th>
                        <th style="text-align:right; padding:8px 0;
                                   font-size:11px; font-weight:600;
                                   color:var(--text-secondary);
                                   text-transform:uppercase;
                                   letter-spacing:.5px; width:100px">
                            Unit price
                        </th>
                        <th style="text-align:right; padding:8px 0;
                                   font-size:11px; font-weight:600;
                                   color:var(--text-secondary);
                                   text-transform:uppercase;
                                   letter-spacing:.5px; width:100px">
                            Amount
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.BillItems)
                    {
                        <tr style="border-bottom:1px solid var(--border)">
                            <td style="padding:10px 0; font-size:14px">
                                @item.Description
                            </td>
                            <td style="padding:10px 0; font-size:14px;
                                           text-align:center;
                                           color:var(--text-secondary)">
                                @item.Quantity
                            </td>
                            <td style="padding:10px 0; font-size:14px;
                                           text-align:right;
                                           color:var(--text-secondary)">
                                ₹@(item.UnitPrice.ToString("N2"))
                            </td>
                            <td style="padding:10px 0; font-size:14px;
                                           text-align:right; font-weight:500">
                                ₹@(item.Amount.ToString("N2"))
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3"
                            style="padding:12px 0; font-size:15px;
                                   font-weight:600; text-align:right">
                            Total amount
                        </td>
                        <td style="padding:12px 0; text-align:right;
                                   font-size:22px; font-weight:700;
                                   color:var(--primary)">
                            ₹@(Model.TotalAmount.ToString("N2"))
                        </td>
                    </tr>
                </tfoot>
            </table>

            @* Bill created date *@
            <p style="font-size:12px; color:var(--text-muted)">
                Bill created:
                @(Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt"))
            </p>
        </div>
    </div>

    @* ── Right: payment options ───────────────────────────────── *@
    <div style="display:flex; flex-direction:column; gap:12px">

        @* Total to pay *@
        <div style="background:var(--primary);
                    border-radius:var(--radius-lg);
                    padding:20px; text-align:center; color:#fff">
            <p style="font-size:13px; opacity:0.85; margin-bottom:6px">
                Total to pay
            </p>
            <p style="font-size:36px; font-weight:700; line-height:1">
                ₹@(Model.TotalAmount.ToString("N2"))
            </p>
        </div>

        @* Cash payment *@
        <div class="form-card" style="padding:16px">
            <h4 style="font-size:14px; font-weight:600;
                       margin-bottom:6px">
                💵 Pay with Cash
            </h4>
            <p style="font-size:12px; color:var(--text-secondary);
                      margin-bottom:14px">
                Pay the technician directly in cash.
                The system will mark your request as complete.
            </p>
            <form asp-action="PayCash" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="billId"
                       value="@Model.BillId" />
                <button type="submit"
                        class="btn-primary"
                        style="width:100%; font-size:15px; padding:12px"
                        onclick="return confirm(
                            'Confirm cash payment of ₹@(Model.TotalAmount.ToString("N2"))?')">
                    Confirm cash payment
                </button>
            </form>
        </div>

        @* Online payment — coming Phase 3 *@
        <div class="form-card"
             style="padding:16px; opacity:0.6">
            <h4 style="font-size:14px; font-weight:600;
                       margin-bottom:6px">
                💳 Pay online
            </h4>
            <p style="font-size:12px; color:var(--text-secondary);
                      margin-bottom:14px">
                UPI, Debit/Credit card, Net Banking via Razorpay.
            </p>
            <button class="btn-outline"
                    style="width:100%" disabled>
                Coming soon
            </button>
        </div>

        @* Security note *@
        <div style="text-align:center; padding:8px">
            <p style="font-size:11px; color:var(--text-muted)">
                🔒 Your payment is secure and protected.
                <br />
                Receipt will be generated on confirmation.
            </p>
        </div>
    </div>
</div>