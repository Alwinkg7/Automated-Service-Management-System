@{
    ViewData["Title"] = "Raise a dispute";
    var request = ViewBag.Request as ServiceApp.Core.Entities.ServiceRequest;
}

<div class="page-header">
    <div>
        <h2>Raise a dispute</h2>
        <span style="font-size:13px; color:var(--text-secondary)">
            Request #@request?.RequestId — @request?.Category
        </span>
    </div>
    <a asp-area="Customer"
       asp-controller="Requests"
       asp-action="Details"
       asp-route-id="@request?.RequestId"
       class="btn-outline">
        ← Back to request
    </a>
</div>

<div style="max-width:560px">
    <div class="form-card">

        @* Warning banner *@
        <div style="background:#FEF3C7; border:1px solid #FDE68A;
                    border-radius:8px; padding:12px 14px;
                    margin-bottom:18px">
            <p style="font-size:13px; font-weight:600;
                      color:#92400E; margin-bottom:4px">
                ⚠ Before raising a dispute
            </p>
            <p style="font-size:12px; color:#78350F; line-height:1.6">
                Please try to resolve the issue directly
                with the technician first.
                Disputes are reviewed by our admin team within
                <strong>48 hours</strong>.
                Providing detailed information speeds up resolution.
            </p>
        </div>

        <form asp-action="Raise" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestId"
                   value="@request?.RequestId" />

            <div class="form-group">
                <label>Reason for dispute</label>
                <select name="reason"
                        class="form-control"
                        required>
                    <option value="">Select a reason...</option>
                    <option value="ServiceQuality">
                        Poor service quality
                    </option>
                    <option value="LateArrival">
                        Technician arrived very late
                    </option>
                    <option value="WrongCharge">
                        Incorrect or overcharged bill
                    </option>
                    <option value="Unprofessional">
                        Unprofessional behavior
                    </option>
                    <option value="JobIncomplete">
                        Job was not completed properly
                    </option>
                    <option value="Other">
                        Other
                    </option>
                </select>
            </div>

            <div class="form-group">
                <label>Describe the issue</label>
                <textarea name="description"
                          class="form-control"
                          rows="5"
                          minlength="20"
                          placeholder="Please describe what happened in detail. Include dates, amounts, and any evidence you have."
                          required></textarea>
                <span class="form-hint">
                    Minimum 20 characters.
                    More detail = faster resolution.
                </span>
            </div>

            <div style="display:flex; gap:10px">
                <button type="submit"
                        class="btn-primary">
                    Submit dispute
                </button>
                <a asp-area="Customer"
                   asp-controller="Requests"
                   asp-action="Details"
                   asp-route-id="@request?.RequestId"
                   class="btn-outline">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>